	)
	(text " FORMULA: ΔV = V_IN * R_S / R_H\n DATA: V_IN = 4,94V, RS = 10k, R_H = 1M\n ΔV = 4,94V * 10k/100M = 0.049V = 49mV"
		(exclude_from_sim no)
		(at 118.872 148.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c26ff899-fd88-4756-ae55-a32dc68bbb73")
	)
	(text "VOLTAGE DIVIDERS (R_TOT ≈ 100 kΩ, V_SUPPLY = 4.94 V)\nFORMULA:\n  R2 = R_TOT × V_REF / 4.94 V\n  R1 = R_TOT − R2\n  (R1 to +5V, R2 to GND)\n\nRESOLUTION:\n  Brake threshold (V_REF = 1.683 V):\n    R2 = 100 kΩ × 1.683 / 4.94 = 34.1 kΩ → 34.0 kΩ\n    R1 = 100 kΩ − 34.1 kΩ = 65.9 kΩ → 66.5 kΩ\n    Check: V_REF = 4.94 × 34.0 / 100.5 = 1.671 V\n\n  Power threshold (V_REF = 2.640 V max):\n    R2 = 100 kΩ × 2.640 / 4.94 = 53.4 kΩ\n    R1 = 100 kΩ − 53.4 kΩ = 46.6 kΩ\n    → E96 pair below 2.640 V: R1 = 44.2 kΩ, R2 = 49.9 kΩ\n    Check: V_REF = 4.94 × 49.9 / 94.1 = 2.620 V\n\n  Window (V_LOW = 0.25 V, V_HIGH = 4.75 V):\n    R_WH = 100 kΩ × (4.94 − 4.75) / 4.94 = 3.85 kΩ → 3.83 kΩ\n    R_WL = 100 kΩ × 0.25 / 4.94 = 5.06 kΩ → 5.11 kΩ\n    R_WM = 100 kΩ − R_WH − R_WL = 91.1 kΩ → 90.9 kΩ\n    Check: V_HIGH = 4.94 × 96.01 / 99.84 = 4.750 V\n           V_LOW  = 4.94 × 5.11 / 99.84 = 0.253 V"
		(exclude_from_sim no)
		(at 19.812 166.116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f7687e2f-1296-4121-a2bb-96fb9db9d33c")
	)

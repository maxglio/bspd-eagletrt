	(text "RC TIMER\nFORMULA:\n  t = τ * ln(V_CC / (V_CC − V_T+)),  τ = R * C\nDATA:\n  V_CC = 4.94 V, V_T+ = 2.60 V (74HC14)\n  t = 485 ms (just below 500 ms), C = 470 nF C0G (largest AEC-Q200 C0G)\nRESOLUTION:\n  t = τ * ln(4.94 / 2.34) = 0.75 * τ\n  τ = 0.485 s / 0.75 = 0.647 s\n  R = τ / C = 0.647 s / 470 nF = 1.376 MΩ -> 1.37 MΩ\nCHECK:\n  t = 0.75 * 1.37 MΩ * 470 nF ≈ 483 ms"
		(exclude_from_sim no)
		(at 18.796 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
